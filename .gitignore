# Sauvegardes de l'application
pilot-shop-sauvegarde-*.json

# Sauvegardes créées par les scripts de modification.
# ATTENTION : la ligne « config.js.avec-pins » se terminait par une ESPACE,
# ce qui la rendait inopérante — Git cherchait un fichier dont le nom finit
# par une espace. Les cinq codes PIN de l'équipe étaient donc versionnés,
# alors qu'on les avait justement retirés de config.js pour cette raison.
config.js.avec-pins
*.avant-*
*.avec-pins
